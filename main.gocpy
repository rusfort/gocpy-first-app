package main

import (
	"std/fmt"
	"std/errors"	
)

func main() {
	text := "first gocpy app"
	fmt.Println(f"Привет, {text}!")
	
	list := []string{"a", "b", "c"}

	for elem in list {
		fmt.Println(elem)
	}

	try {
		testThrows()
	} catch e {
		fmt.Println(f"Caught an error: {e}")
	} finally {
		fmt.Println("Finally block executed.")
	}
}

@throws
func testThrows() {
	throw errors.New("error: this is a test error")
}
