package main

import (
	"std/fmt"
	"std/errors"	
	gtl "github.com/rusfort/gocpy-test-lib"
)

func main() {
	text := "first gocpy app"
	fmt.Println(f"Привет, {text}!")
	
	list := []string{"a", "b", "c"}

	for elem in list {
		fmt.Println(elem)
	}

	unsafe {
		ptr := malloc(16)
		free(ptr)
	}

	unusedVar := 0 //gocpy:ignore:unused
	
	try {
		testThrows()
	} catch e {
		fmt.Println(f"Caught an error: {e}")
	} finally {
		fmt.Println("Finally block executed.")
	}

	gtl.PrintBibaBoba()
	
	fmt.Println(testError())
}

@throws
func testThrows() {
	throw errors.New("error: this is a test error")
}

func testError() error {
	errorCall()?

	return nil
}

func errorCall() error{
	return errors.New("error: this is a test error")
}
